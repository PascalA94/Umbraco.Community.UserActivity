<Project>
  <!--
    One codebase, two Umbraco lines. UmbracoMajor selects the line: 18 (default) or 17.
      dotnet build -p:UmbracoMajor=17
    It sets the CMS range, the package version, the UMBRACO_17 / UMBRACO_18 constants, and a separate lock file and
    obj folder per line, so switching lines never reuses the other line's restore.

    Lock files describe the floor: they are generated and committed at the default values of UmbracoTestVersion and
    UmbracoDemoVersion (the line's floor), and the floor CI legs restore in locked mode. The latest-minor CI legs override
    these two properties (17.* or 18.*) and restore unlocked (force-evaluate, RestoreLockedMode=false); the lock files
    they rewrite are never committed. Nothing else overrides these properties.

    Floors never go below 17.8.0 / 18.3.0: they sit above the 27 Oct 2026 advisories. Lowering one needs a security
    review first.
  -->
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">18</UmbracoMajor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoFloor>17.8.0</UmbracoFloor>
    <UmbracoNextMajor>18.0.0</UmbracoNextMajor>
    <DefineConstants>$(DefineConstants);UMBRACO_17</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoFloor>18.3.0</UmbracoFloor>
    <UmbracoNextMajor>19.0.0</UmbracoNextMajor>
    <DefineConstants>$(DefineConstants);UMBRACO_18</DefineConstants>
  </PropertyGroup>
  <!--
    Runtime adapters (design 3.2): compile-only references to optional integrations, one version per line, always
    referenced with PrivateAssets="all" ExcludeAssets="runtime" so they never become NuGet dependencies or ship DLLs.
    Each is the oldest supported release on that line, set from S7 (docs/spikes.md). Empty = no compile reference on that line:
    Archived Users is read from core umbracoLog rows (S5), and Forms Audit Trail is not a source in 0.1 (Pascal, 2026-11-07).
    The recorder's handlers (M5, design 4.1) follow the same rule, from the M5 handler probe in docs/spikes.md:
    CspManagerCompileVersion, WorkflowCompileVersion (Umbraco.Workflow.Core), SkybrudRedirectsCompileVersion and
    UrlTrackerCompileVersion (UrlTracker.Core). UrlTracker has no stable 18.x release, so it is empty on line 18 and
    its handlers are compiled out there (#if UMBRACO_17).
  -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <AICompileVersion>17.0.0</AICompileVersion>
    <!-- ISyncHistoryService first ships in uSync 17.3.0; the guard's probe hides the source on 17.0.x. -->
    <USyncCompileVersion>17.3.0</USyncCompileVersion>
    <ArchivedUsersCompileVersion></ArchivedUsersCompileVersion>
    <FormsAuditTrailCompileVersion></FormsAuditTrailCompileVersion>
    <CspManagerCompileVersion>17.0.0</CspManagerCompileVersion>
    <WorkflowCompileVersion>17.0.0</WorkflowCompileVersion>
    <!-- The redirect notifications first ship in Skybrud.Umbraco.Redirects 17.0.5; the guard hides it on 17.0.0-17.0.4. -->
    <SkybrudRedirectsCompileVersion>17.0.5</SkybrudRedirectsCompileVersion>
    <UrlTrackerCompileVersion>17.0.0</UrlTrackerCompileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <AICompileVersion>18.0.0</AICompileVersion>
    <USyncCompileVersion>18.0.0</USyncCompileVersion>
    <ArchivedUsersCompileVersion></ArchivedUsersCompileVersion>
    <FormsAuditTrailCompileVersion></FormsAuditTrailCompileVersion>
    <CspManagerCompileVersion>18.0.0</CspManagerCompileVersion>
    <WorkflowCompileVersion>18.0.0</WorkflowCompileVersion>
    <SkybrudRedirectsCompileVersion>18.0.0</SkybrudRedirectsCompileVersion>
    <!-- No stable UrlTracker 18.x yet (18.0.0-beta.3 only): left out of this line (docs/spikes.md, M5 handler probe). -->
    <UrlTrackerCompileVersion></UrlTrackerCompileVersion>
  </PropertyGroup>

  <Target Name="ValidateUmbracoMajor" BeforeTargets="Restore;Build;CoreCompile" Condition="'$(UmbracoMajor)' != '17' and '$(UmbracoMajor)' != '18'">
    <Error Text="UmbracoMajor must be 17 or 18 (got '$(UmbracoMajor)')." />
  </Target>

  <PropertyGroup>
    <!-- 17.x and 18.x ship from one tag release/<PackageMinor>.<PackagePatch>[-suffix]; the major comes from the line.
         An empty suffix is a stable release (17.0.0 and 18.0.0); set it to alpha.1 for a prerelease. -->
    <PackageMinor>1</PackageMinor>
    <PackagePatch>0</PackagePatch>
    <PackageVersionSuffix></PackageVersionSuffix>
    <UmbracoRange>[$(UmbracoFloor), $(UmbracoNextMajor))</UmbracoRange>
    <UmbracoTestVersion Condition="'$(UmbracoTestVersion)' == ''">$(UmbracoFloor)</UmbracoTestVersion>
    <UmbracoDemoVersion Condition="'$(UmbracoDemoVersion)' == ''">$(UmbracoFloor)</UmbracoDemoVersion>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.$(UmbracoMajor).lock.json</NuGetLockFilePath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(UmbracoMajor)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/$(UmbracoMajor)/</BaseOutputPath>
    <!-- Per-line obj/bin folders: without this the other line's generated .cs files are globbed in (CS0579). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <!-- Audit direct and transitive dependencies; build/check-vulnerable.sh is the PR and release gate. -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
