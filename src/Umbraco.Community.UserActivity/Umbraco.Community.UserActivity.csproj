<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Community.UserActivity</RootNamespace>
    <!-- Client assets in wwwroot are served at /App_Plugins/UserActivity/ via static web assets.
         The alias and path are permanent once released. -->
    <StaticWebAssetBasePath>App_Plugins/UserActivity</StaticWebAssetBasePath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.UserActivity</PackageId>
    <!-- MSBuild adds the hyphen only when the suffix is non-empty, so a stable release (empty suffix) is a valid version. -->
    <VersionPrefix>$(UmbracoMajor).$(PackageMinor).$(PackagePatch)</VersionPrefix>
    <VersionSuffix>$(PackageVersionSuffix)</VersionSuffix>
    <Authors>Pascal Meyer</Authors>
    <Description>A per-user Activity tab and a global Activity view under Users, reading Umbraco's audit logs and other packages' history.</Description>
    <Copyright>Copyright © Pascal Meyer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/PascalA94/Umbraco.Community.UserActivity</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PascalA94/Umbraco.Community.UserActivity</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;umbraco-marketplace;umbracopackage;plugin;package</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Debugging support: Source Link plus a .snupkg symbol package -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic, path-normalised builds in CI so published binaries are reproducible -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Floors: above the 27 Oct 2026 advisories. Never lower them without a security review. -->
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoRange)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoRange)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <!-- The client source is not package content; only the built wwwroot assets ship -->
    <Content Remove="Client\**" />
    <None Include="Client\**" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.UserActivity.Tests" />
    <InternalsVisibleTo Include="Umbraco.Community.UserActivity.IntegrationTests" />
    <!-- NSubstitute proxies for internal types -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
