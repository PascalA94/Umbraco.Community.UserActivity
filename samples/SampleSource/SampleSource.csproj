<Project Sdk="Microsoft.NET.Sdk">

  <!-- A third-party source, as another package would write it. Builds in CI with the solution; never packed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SampleSource</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.Community.UserActivity\Umbraco.Community.UserActivity.csproj" />
  </ItemGroup>

</Project>
